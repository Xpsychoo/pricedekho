# PriceDekho environment variables
# Copy to apps/web/.env.local for local development. Never commit real values.
# With NOTHING set, the app runs in demo mode using the bundled sample catalog.

# --- Site -------------------------------------------------------------------
# Public base URL, used for canonical URLs, sitemap and robots.
# On Vercel, VERCEL_URL is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (public, RLS-restricted) ---------------------------------------
# Set BOTH or NEITHER. Found in Supabase dashboard → Project Settings → API Keys.
# The publishable key is safe to expose; Row Level Security limits it to
# reading published catalog data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (PRIVILEGED, server-only) --------------------------------------
# Secret key (sb_secret_...). Bypasses RLS. Used ONLY by the price-refresh cron
# route. Never prefix with NEXT_PUBLIC_ and never use it for public reads.
SUPABASE_SECRET_KEY=

# --- Scheduled price refresh -------------------------------------------------
# Required for /api/cron/refresh-prices. At least 32 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Vercel Cron automatically sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Max offers processed per refresh run (1–100).
REFRESH_BATCH_SIZE=25

# Hours after which a verified price is labelled "Stale — refresh required".
PRICE_FRESHNESS_HOURS=24

# Minimum hours between history rows for an unchanged price.
PRICE_OBSERVATION_INTERVAL_HOURS=24

# --- Safety switches ----------------------------------------------------------
# Set to "true" in production so a missing database is a startup error instead
# of silently falling back to demo data.
PRICEDEKHO_REQUIRE_DATABASE=false

# Register the demo provider (it never refreshes, so it only affects search).
PRICEDEKHO_ENABLE_DEMO_PROVIDER=true

# --- Rate limiting (optional, recommended in production) ---------------------
# Without these, rate limits are per serverless instance (best-effort only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Images (optional) --------------------------------------------------------
# Comma-separated hostnames whose product images you are PERMITTED to display.
# Images from any other host are replaced with a neutral placeholder.
IMAGE_REMOTE_HOSTS=

# --- Provider credentials -----------------------------------------------------
# None exist yet. Add variables here when an authorised integration is built,
# e.g. EXAMPLE_AFFILIATE_API_KEY=. See docs/PROVIDERS.md.
